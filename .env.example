# --- Servidor ---
PORT=4000
FRONTEND_URL=http://localhost:4200

# --- JWT ---
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# --- Admin Seed ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia_esta_clave_ahora
SEED_DEMO=false

# --- Supabase (Producción) ---
# IMPORTANTE: Reemplaza [YOUR-PASSWORD] por tu contraseña real de Supabase
DATABASE_URL=postgresql://postgres.ghlnkdapxovehhlrvkjc:TU_CONTRASEÑA_REAL_AQUI@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Notificaciones ---
# Email (Usaremos Gmail como ejemplo, pero sirve cualquier SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_gmail # NO es tu contraseña normal, es una "App Password"
ADMIN_EMAIL=admin@peluqueria.com # A dónde llegará la alerta

# WhatsApp (Deshabilitado por defecto para el portafolio)
ENABLE_WHATSAPP=false
WHATSAPP_API_URL=https://api.ultramsg.com/tu_instancia/messages/chat
